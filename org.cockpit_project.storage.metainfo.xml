  <launchable type="cockpit-manifest">storage</launchable>
  <url type="homepage">https://github.com/gerrydoro/cockpit-storage</url>
  <url type="bugtracker">https://github.com/gerrydoro/cockpit-storage/issues</url>
  <update_contact>cockpit-devel_AT_lists.fedorahosted.org</update_contact>
  <developer id="org.cockpit-project">
    <name>Cockpit Project</name>
  </developer>
